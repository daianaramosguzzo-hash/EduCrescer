{
  "name": "ultimo-refugio-aimores",
  "productName": "Último Refúgio",
  "version": "0.1.0",
  "description": "Último Refúgio: Aimorés — jogo de sobrevivência pós-apocalíptico 2,5D",
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "br.educrescer.ultimorefugio",
    "productName": "Último Refúgio",
    "directories": {
      "output": "dist",
      "buildResources": "desktop"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "lib/**",
      "assets/**",
      "desktop/main.js",
      "desktop/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Último Refúgio",
      "artifactName": "Ultimo-Refugio-Setup-${version}.${ext}",
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico",
      "language": "1046"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
